{
  // VARIANT used to test Cloudflare's declarative `exports` (mutually exclusive with `migrations`).
  // To try: swap this file in as wrangler.jsonc, then `npx vite build && npx wrangler deploy --dry-run`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue2-spike",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "SLACK_EVENTS", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["*/2 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "flue2-spike", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "exports": {
    "FlueProjectAgent": { "type": "durable-object", "state": "created", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "state": "created", "storage": "sqlite" },
    "FlueRegistry": { "type": "durable-object", "state": "deleted" }
  }
}
